  aro2TreatmentCatalog     OpticalTreatmentCatalog? @relation("Aro2Treatment", fields: [aro2TreatmentCatalogId], references: [id], onDelete: SetNull)
  aro2TreatmentDescription  String?
  aro2TreatmentPrice       Decimal                  @default(0.00) @db.Decimal(10, 2)

  aro2OdSphere             Decimal?                 @db.Decimal(5, 2)
  aro2OdCyl                Decimal?                 @db.Decimal(5, 2)
  aro2OdAxis               Int?
  aro2OdAdd                Decimal?                 @db.Decimal(4, 2)
  aro2OdAlt                Decimal?                 @db.Decimal(4, 1)
  aro2OdDnp                Decimal?                 @db.Decimal(4, 1)

  aro2OeSphere             Decimal?                 @db.Decimal(5, 2)
  aro2OeCyl                Decimal?                 @db.Decimal(5, 2)
  aro2OeAxis               Int?
  aro2OeAdd                Decimal?                 @db.Decimal(4, 2)
  aro2OeAlt                Decimal?                 @db.Decimal(4, 1)
  aro2OeDnp                Decimal?                 @db.Decimal(4, 1)

  subtotalAmount           Decimal                  @db.Decimal(12, 2)
  discountAmount           Decimal                  @default(0.00) @db.Decimal(12, 2)
  totalAmount              Decimal                  @db.Decimal(12, 2)
  paidAmount               Decimal                  @default(0.00) @db.Decimal(12, 2)
  residualAmount           Decimal                  @default(0.00) @db.Decimal(12, 2)
  paymentMode              OpticalPaymentMode       @default(SINAL)

  payments                 OpticalPayment[]
  labConference            OpticalLabConference?
  occurrences              OpticalOccurrence[]
  activities               Activity[]               @relation("OrderActivities")
  agentTasks               AgentTask[]              @relation("OrderAgentTasks")
  conversations            AgentConversation[]      @relation("OrderConversations")

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([storeId])
  @@index([sellerId])
  @@index([customerId])
  @@index([status])
  @@index([promisedDeliveryDate])
  @@index([residualAmount])
  @@map("opticalOrder")
}

model OpticalPayment {
  id              String               @id @default(cuid())
  orderId         String
  order           OpticalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type            OpticalPaymentStage  @default(SINAL)
  method          OpticalPaymentMethod
  amount          Decimal              @db.Decimal(10, 2)
  installments    Int                  @default(1)
  cardBrand       String?
  transactionCode String?
  receiptUrl      String?

  paidAt          DateTime             @default(now())
  receivedById    String?
  receivedBy      User?                @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([orderId])
  @@index([type])
  @@index([paidAt])
  @@map("opticalPayment")
}

model OpticalLensCatalog {
  id                   String               @id @default(cuid())
  code                 String?
  brand                String
  tier                 OpticalLensTier
  family               String
  design               String
  name                 String
  lensType             OpticalLensType
  material             OpticalLensMaterial
  refractiveIndex      Decimal              @db.Decimal(3, 2)
  technology           String
  laserEngraving       String?

  minSphere            Decimal?             @db.Decimal(5, 2)
  maxSphere            Decimal?             @db.Decimal(5, 2)
  maxCylinder          Decimal?             @db.Decimal(5, 2)
  minAddition          Decimal?             @db.Decimal(4, 2)
  maxAddition          Decimal?             @db.Decimal(4, 2)
  heightOptions        String?

  labBaseCost          Decimal              @db.Decimal(10, 2)
  suggestedMarkup      Decimal              @default(8.00) @db.Decimal(5, 2)
  suggestedRetailPrice Decimal              @db.Decimal(10, 2)
  minRetailPrice       Decimal?             @db.Decimal(10, 2)

  labId                String?
  lab                  Company?             @relation("LabLensCatalog", fields: [labId], references: [id], onDelete: SetNull)

  isActive             Boolean              @default(true)

  aro1Orders           OpticalOrder[]       @relation("Aro1Lens")
  aro2Orders           OpticalOrder[]       @relation("Aro2Lens")

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([brand, tier])
  @@index([lensType, material])
  @@index([name])
  @@map("opticalLensCatalog")
}

model OpticalTreatmentCatalog {
  id              String           @id @default(cuid())
  name            String
  tier            OpticalLensTier
  brand           String
  labCost         Decimal          @db.Decimal(10, 2)
  retailPrice     Decimal          @db.Decimal(10, 2)

  labId           String?
  lab             Company?         @relation("LabTreatments", fields: [labId], references: [id], onDelete: SetNull)

  isActive        Boolean          @default(true)

  aro1Orders      OpticalOrder[]   @relation("Aro1Treatment")
  aro2Orders      OpticalOrder[]   @relation("Aro2Treatment")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([brand])
  @@map("opticalTreatmentCatalog")
}

model OpticalLabConference {
  id                     String                  @id @default(cuid())
  orderId                String                  @unique
  order                  OpticalOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  labInvoiceNumber       String?
  labInvoiceDate         DateTime?

  expectedLensCost       Decimal                 @db.Decimal(10, 2)
  effectiveLensCost      Decimal                 @db.Decimal(10, 2)

  expectedTreatmentCost  Decimal                 @db.Decimal(10, 2)
  effectiveTreatmentCost Decimal                 @db.Decimal(10, 2)

  totalExpectedCost      Decimal                 @db.Decimal(10, 2)
  totalEffectiveCost     Decimal                 @db.Decimal(10, 2)
  costDivergence         Decimal                 @default(0.00) @db.Decimal(10, 2)

  status                 OpticalConferenceStatus @default(OK)

  auditedById            String?
  auditedBy              User?                   @relation("ConferenceAuditor", fields: [auditedById], references: [id], onDelete: SetNull)
  auditedAt              DateTime?
  notes                  String?

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status])
  @@map("opticalLabConference")
}

model OpticalOccurrence {
  id                    String                  @id @default(cuid())
  orderId               String
  order                 OpticalOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  storeId               String
  store                 Company                 @relation("StoreOccurrences", fields: [storeId], references: [id], onDelete: Restrict)
  customerId            String
  customer              Contact                 @relation("CustomerOccurrences", fields: [customerId], references: [id], onDelete: Restrict)

  handlerId             String?
  handler               User?                   @relation("OccurrenceHandler", fields: [handlerId], references: [id], onDelete: SetNull)

  reason                OpticalOccurrenceReason
  description           String
  additionalLabCost     Decimal                 @default(0.00) @db.Decimal(10, 2)
  customerChargedAmount Decimal                 @default(0.00) @db.Decimal(10, 2)
  status                OpticalOccurrenceStatus @default(ABERTA)
  resolutionNotes       String?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([orderId])
  @@index([storeId])
  @@index([reason, status])
  @@map("opticalOccurrence")
}

model OpticalDoctorVisit {
  id               String    @id @default(cuid())
  doctorId         String
  doctor           Contact   @relation("DoctorVisits", fields: [doctorId], references: [id], onDelete: Cascade)

  consultantId     String
  consultant       User      @relation("ConsultantVisits", fields: [consultantId], references: [id], onDelete: Restrict)

  visitedAt        DateTime
  purpose          String
  notes            String?
  samplesDelivered String?
  nextVisitDate    DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([doctorId])
  @@index([consultantId])
  @@map("opticalDoctorVisit")
}
